{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/contracts/daedalus-trace-v2.schema.json",
  "title": "Daedalus trajectory event envelope v2",
  "type": "object",
  "required": ["at", "schema_version", "run_id", "event"],
  "properties": {
    "at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "daedalus-trace/v2"},
    "run_id": {"type": "string", "minLength": 1},
    "event": {
      "enum": [
        "experiment_metadata", "task_started", "plan_produced", "step_started",
        "agent_message", "thought", "context_considered", "exchange",
        "exchange_delta", "tool_call", "oracle_verdict", "context_compacted",
        "interjected", "halt", "hypothesis", "redirected", "task_finished",
        "evaluation_finished"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"enum": ["exchange", "exchange_delta"]}}},
      "then": {"required": ["response"]}
    },
    {
      "if": {"properties": {"event": {"const": "evaluation_finished"}}},
      "then": {
        "required": [
          "case_id", "grader_pass", "verifier_pass", "halt_reason",
          "provider_status", "infrastructure_status", "tamper"
        ]
      }
    }
  ],
  "additionalProperties": true
}
