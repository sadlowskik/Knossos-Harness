{
  "name": "knossos-harness",
  "displayName": "Knossos Harness",
  "description": "Agentic coding with exact symbol grounding, tiered verification and an explicit halting policy.",
  "version": "0.2.0-beta.2",
  "license": "MIT",
  "publisher": "korbinsadlowski",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "knossos",
          "title": "Knossos",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "knossos": [
        {
          "id": "knossos.session",
          "name": "Session",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "knossos.openPanel",
        "title": "Knossos: Open Session Panel",
        "category": "Knossos"
      },
      {
        "command": "knossos.task",
        "title": "Knossos: Run Task",
        "category": "Knossos"
      },
      {
        "command": "knossos.preview",
        "title": "Knossos: Preview Task (dry run)",
        "category": "Knossos"
      },
      {
        "command": "knossos.verify",
        "title": "Knossos: Verify Workspace",
        "category": "Knossos"
      },
      {
        "command": "knossos.index",
        "title": "Knossos: Show Symbol Index",
        "category": "Knossos"
      },
      {
        "command": "knossos.lookup",
        "title": "Knossos: Look Up Symbol",
        "category": "Knossos"
      },
      {
        "command": "knossos.setApiKey",
        "title": "Knossos: Set API Key",
        "category": "Knossos"
      },
      {
        "command": "knossos.clearApiKey",
        "title": "Knossos: Clear Stored API Key",
        "category": "Knossos"
      },
      {
        "command": "knossos.locateBinary",
        "title": "Knossos: Locate Executable",
        "category": "Knossos"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "knossos.lookup",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Knossos Harness",
      "properties": {
        "knossos.binaryPath": {
          "type": "string",
          "default": "knossos",
          "description": "Path to the Knossos executable. Usually unnecessary — the extension looks in the workspace's target/release and target/debug, then a sibling Knossos-Harness checkout, then PATH. Run 'Knossos: Locate Executable' to set this with a file picker."
        },
        "knossos.engine": {
          "type": "string",
          "enum": ["anthropic", "ollama"],
          "default": "anthropic",
          "description": "Which engine backend to drive."
        },
        "knossos.model": {
          "type": "string",
          "default": "",
          "description": "Model id. Empty uses the engine's default."
        },
        "knossos.maxSteps": {
          "type": "number",
          "default": 12,
          "description": "Hard ceiling on engine turns."
        },
        "knossos.targetSteps": {
          "type": "number",
          "default": 6,
          "description": "Where budget pressure begins."
        },
        "knossos.judge": {
          "type": "boolean",
          "default": true,
          "description": "Run Oracle tier 4 (model judgement against the constitution) once the deterministic tiers pass."
        },
        "knossos.previewByDefault": {
          "type": "boolean",
          "default": true,
          "description": "The session panel stages changes for review instead of writing them straight to disk. Turn this off and the panel edits files directly."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
