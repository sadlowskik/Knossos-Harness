{
  "name": "daedalus-harness",
  "displayName": "Daedalus Harness",
  "description": "Agentic coding with exact symbol grounding, tiered verification and an explicit halting policy.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "korbinsadlowski",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "daedalus",
          "title": "Daedalus",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "daedalus": [
        {
          "id": "daedalus.session",
          "name": "Session",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "daedalus.openPanel",
        "title": "Daedalus: Open Session Panel",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.task",
        "title": "Daedalus: Run Task",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.preview",
        "title": "Daedalus: Preview Task (dry run)",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.verify",
        "title": "Daedalus: Verify Workspace",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.index",
        "title": "Daedalus: Show Symbol Index",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.lookup",
        "title": "Daedalus: Look Up Symbol",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.setApiKey",
        "title": "Daedalus: Set API Key",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.clearApiKey",
        "title": "Daedalus: Clear Stored API Key",
        "category": "Daedalus"
      },
      {
        "command": "daedalus.locateBinary",
        "title": "Daedalus: Locate Executable",
        "category": "Daedalus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "daedalus.lookup",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Daedalus Harness",
      "properties": {
        "daedalus.binaryPath": {
          "type": "string",
          "default": "daedalus",
          "description": "Path to the daedalus executable. Usually unnecessary — the extension looks in the workspace's target/release and target/debug, then a sibling daedalus-harness checkout, then PATH. Run 'Daedalus: Locate Executable' to set this with a file picker."
        },
        "daedalus.engine": {
          "type": "string",
          "enum": ["anthropic", "ollama"],
          "default": "anthropic",
          "description": "Which engine backend to drive."
        },
        "daedalus.model": {
          "type": "string",
          "default": "",
          "description": "Model id. Empty uses the engine's default."
        },
        "daedalus.maxSteps": {
          "type": "number",
          "default": 12,
          "description": "Hard ceiling on engine turns (Ariadne's forced halt)."
        },
        "daedalus.targetSteps": {
          "type": "number",
          "default": 6,
          "description": "Where budget pressure begins."
        },
        "daedalus.judge": {
          "type": "boolean",
          "default": true,
          "description": "Run Oracle tier 4 (model judgement against the constitution) once the deterministic tiers pass."
        },
        "daedalus.previewByDefault": {
          "type": "boolean",
          "default": true,
          "description": "The session panel stages changes for review instead of writing them straight to disk. Turn this off and the panel edits files directly."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
